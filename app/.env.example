# ---------------------------------------------------------------------------
# TCA Move — variáveis de ambiente
# Copie para `.env` e preencha. O `.env` NUNCA vai para o Git.
# ---------------------------------------------------------------------------

# Conexão com o PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
# Se a senha tiver caracteres especiais (@ : / ?), use percent-encoding.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/tcamove?schema=public"

# Segredo usado pelo NextAuth para assinar os cookies de sessão.
# Gere um novo com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"

# URL pública da aplicação. Deixe comentado em desenvolvimento: com
# AUTH_TRUST_HOST o NextAuth usa o host da requisição, então funciona em
# qualquer porta. Em produção, defina o domínio real.
# AUTH_URL="https://seu-dominio.com.br"

# Confia no host recebido — necessário em dev e atrás de proxy reverso.
AUTH_TRUST_HOST="true"
